<?xml version="1.0" encoding="UTF-8"?>
<config>
    <!-- 大容量ファイル警告の閾値（MB） -->
    <large_file_warning_threshold_mb>20</large_file_warning_threshold_mb>
    
    <!-- 1ファイルあたりの最大マッチ数（0 = 無制限）。画面の「詳細条件」でも変更できます -->
    <search_max_matches_per_file>1000</search_max_matches_per_file>
    
    <!-- ログファイルの最大行数 -->
    <logs_max_lines_per_file>1000</logs_max_lines_per_file>
    
    <!-- ログレベル: Debug / Information / Warning / Critical -->
    <logging_level>Information</logging_level>
    
    <!-- 検索の並列数（0 = CPU数から自動、1 = 並列化しない） -->
    <search_workers>0</search_workers>
    
    <!-- 抽出結果キャッシュ（同じフォルダの2回目以降の検索を高速化） -->
    <extraction_cache_enabled>true</extraction_cache_enabled>
    
    <!-- キャッシュ（抽出結果・変換済みPDF）それぞれの上限（MB） -->
    <cache_max_size_mb>500</cache_max_size_mb>
    
    <!-- Officeファイルの原本表示に使う変換エンジン
         auto: Microsoft Office → LibreOffice の順に自動選択
         msoffice / libreoffice: 指定したものだけを使う
         none: 変換しない（常にテキスト表示） -->
    <office_converter>auto</office_converter>
    
    <!-- LibreOffice（soffice）の場所。空なら自動検出 -->
    <libreoffice_path></libreoffice_path>
    
    <!-- 原本表示用の変換を打ち切るまでの秒数 -->
    <preview_conversion_timeout_sec>120</preview_conversion_timeout_sec>
    
    <!-- プレビューで強調表示するマッチ箇所の上限 -->
    <preview_max_hits>1000</preview_max_hits>
    
    <!-- 対象拡張子 -->
    <target_extensions>
        <ext>pptx</ext>
        <ext>ppt</ext>
        <ext>xlsx</ext>
        <ext>xlsm</ext>
        <ext>xls</ext>
        <ext>docx</ext>
        <ext>doc</ext>
        <ext>pdf</ext>
        <ext>md</ext>
        <ext>txt</ext>
        <ext>log</ext>
    </target_extensions>
    
    <!-- 検索のデフォルト設定 -->
    <search_defaults>
        <case_sensitive>false</case_sensitive>
        <use_regex>false</use_regex>
        <match_whole>false</match_whole>
        <include_subfolders>true</include_subfolders>
    </search_defaults>
    
    <!-- 正規表現オプションのデフォルト -->
    <regex_options>
        <ignore_case>true</ignore_case>
        <multiline>false</multiline>
        <dot_matches_newline>false</dot_matches_newline>
    </regex_options>
</config>
